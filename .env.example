# Copy to .env for local development. Never commit real values.
# In production these are set in Railway, not in code.

# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/noticedesk?schema=public"

# Claude API key (used for notice extraction)
ANTHROPIC_API_KEY=""

# Auth.js secret — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Where uploaded notices are stored (Railway volume in production: /data/uploads)
UPLOAD_DIR="./uploads"
